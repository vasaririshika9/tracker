# Public Supabase config (safe for the browser). Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development only: set to "true" to use the on-screen mock OTP when Supabase is not configured.
# Mock mode never sends any email or SMS. Leave "false" in production.
VITE_ENABLE_MOCK_AUTH=false
